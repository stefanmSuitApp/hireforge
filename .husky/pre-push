# Blocking: everything CI `checks` runs, since PRs get no GitHub Actions
# (Nx caches unchanged projects). `pnpm test` includes the merged-migration
# guard (libs/database). e2e needs a database, so it stays a manual step.
pnpm verify || exit 1

# Warn-only (never blocks): design tokens and contrast report.
pnpm --silent check:design | tail -1 || true
pnpm --silent check:contrast | tail -1 || true
