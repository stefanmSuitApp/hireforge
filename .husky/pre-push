# Blocking: the same cheap gates as CI `checks` (Nx caches unchanged projects).
# `pnpm test` includes the merged-migration guard (libs/database).
pnpm lint && pnpm typecheck && pnpm test && pnpm check:i18n || exit 1

# Warn-only (never blocks): design tokens and contrast report.
pnpm --silent check:design | tail -1 || true
pnpm --silent check:contrast | tail -1 || true
