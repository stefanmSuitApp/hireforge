# syntax=docker/dockerfile:1.7

# Node 20 reached end-of-life in April 2026; CI and local dev run 24.
FROM node:24-bookworm-slim AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

WORKDIR /app

RUN npm install --global pnpm@10.28.0

FROM base AS deps

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml nx.json tsconfig.base.json ./
RUN pnpm install --frozen-lockfile

FROM deps AS builder

# One-shot build: the Nx daemon only adds startup cost here, and under memory
# pressure it has hung and exited 0 without producing output.
ENV NX_DAEMON=false

ENV NODE_ENV=production

COPY . .
RUN pnpm build:api && test -f dist/apps/api/main.js && test -f dist/apps/api/pnpm-lock.yaml

# Runtime: the webpack bundle plus only the packages it requires (Nx writes a
# trimmed package.json + lockfile next to it), not the monorepo's ~4 GB of
# node_modules. The same image runs migrations (`migrate` service).
FROM base AS runner

ENV NODE_ENV=production
ENV API_PORT=4000

COPY --from=builder /app/dist/apps/api/package.json /app/dist/apps/api/pnpm-lock.yaml ./
COPY --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
RUN pnpm install --prod --frozen-lockfile --store-dir /tmp/pnpm-store \
  && rm -rf /tmp/pnpm-store

COPY --from=builder /app/drizzle ./drizzle
# Production-safe scripts only: no dev seed (`seed-domain-baseline`) here.
COPY --from=builder /app/scripts/db/migrate.mjs /app/scripts/db/seed-rs-locations.mjs /app/scripts/db/backup-offsite.mjs ./scripts/db/
COPY --from=builder /app/scripts/db/data ./scripts/db/data
COPY --from=builder /app/scripts/storage/copy-uploads-to-bucket.mjs ./scripts/storage/
COPY --from=builder /app/dist/apps/api ./dist/apps/api

EXPOSE 4000

CMD ["node", "dist/apps/api/main.js"]
