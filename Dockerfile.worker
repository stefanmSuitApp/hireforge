# syntax=docker/dockerfile:1.7

# Node 20 reached end-of-life in April 2026; CI and local dev run 24.
FROM node:24-bookworm-slim AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

WORKDIR /app

RUN npm install --global pnpm@10.28.0

FROM base AS deps

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml nx.json tsconfig.base.json ./
RUN pnpm install --frozen-lockfile

FROM deps AS builder

# One-shot build: the Nx daemon only adds startup cost here, and under memory
# pressure it has hung and exited 0 without producing output.
ENV NX_DAEMON=false

ENV NODE_ENV=production

COPY . .
RUN pnpm build:worker && test -f dist/apps/worker/main.js && test -f dist/apps/worker/pnpm-lock.yaml

# Runtime: compiled worker plus only the packages it requires (Nx's trimmed
# package.json + lockfile), not the monorepo's node_modules.
FROM base AS runner

ENV NODE_ENV=production

COPY --from=builder /app/dist/apps/worker/package.json /app/dist/apps/worker/pnpm-lock.yaml ./
COPY --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
RUN pnpm install --prod --frozen-lockfile --store-dir /tmp/pnpm-store \
  && rm -rf /tmp/pnpm-store

COPY --from=builder /app/dist/apps/worker ./dist/apps/worker
# Lib test files get compiled along with the libs (bundle: false); not needed.
RUN find dist/apps/worker -name '*.test.js' -delete

CMD ["node", "dist/apps/worker/main.js"]
